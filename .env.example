# Placeholders only. Copy to .env for local use; never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://booking:CHANGE_ME@localhost:5432/booking
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
JWT_SECRET=CHANGE_ME_minimum_32_characters_long_random
JWT_ISSUER=booking-service
JWT_AUDIENCE=booking-api
AMQP_URL=amqp://booking:CHANGE_ME@localhost:5672
SHUTDOWN_GRACE_MS=10000

# Docker Compose only (docker compose reads these from .env). Use URL-safe values for passwords.
POSTGRES_USER=booking
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=booking
API_PORT=3000
